# ========================================
# Zsh Script for Environment Variables
# ========================================

# Enables colored output for command-line tools that support colorization on macOS
export CLICOLOR=1

# Defines the color scheme for different file types and attributes in ls output
export LSCOLORS=ExFxBxDxCxegedabagacad

# Defines the color style for matches when using grep
export GREP_COLOR='1;32;40' # green